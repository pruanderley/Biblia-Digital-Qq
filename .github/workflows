name: Build APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Install dependencies
        run: npm install

      - name: Remove android folder if exists
        run: rm -rf android

      - name: Add Android platform
        run: npx cap add android

      - name: Copy MainActivity.java
        run: |
          mkdir -p android/app/src/main/java/biblia/digital/qq/
          cp patches/MainActivity.java android/app/src/main/java/biblia/digital/qq/MainActivity.java

      - name: Sync Capacitor
        run: npx cap sync android

      - name: Make gradlew executable
        run: chmod +x android/gradlew

      - name: Build debug APK
        working-directory: android
        run: ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: biblia-digital-qq
          path: android/app/build/outputs/apk/debug/app-debug.apk
